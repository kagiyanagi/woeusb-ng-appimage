#!/bin/bash
###############################################################################
# AppRun - Self-contained launcher for WoeUSB-ng AppImage
# Handles GUI (default) and CLI (--cli) modes with root elevation
###############################################################################

APPDIR=$(dirname "$(readlink -f "$0")")

# --- Binary paths ------------------------------------------------------------
# Bundled binaries find their libraries through RPATH (see build.sh), so no
# LD_LIBRARY_PATH: it would leak into the host tools WoeUSB-ng runs.
export PATH="$APPDIR/usr/sbin:$APPDIR/usr/bin:$PATH"

# The bundled OpenSSL looks for CAs where EL9 keeps them; use the host's.
if [ -z "${SSL_CERT_FILE:-}" ]; then
    for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
        [ -f "$f" ] && export SSL_CERT_FILE="$f" && break
    done
fi

# --- GTK / GDK / Pango -------------------------------------------------------
export GTK_DATA_PREFIX="$APPDIR/usr"
export GTK_THEME=Adwaita
export GTK3_MODULES=""

# Keep the host's GTK, GIO and gdk-pixbuf plugins out of the process: they are
# built against the host's newer GTK/GLib and crash ours.
export GTK_EXE_PREFIX="$APPDIR/usr"
export GIO_MODULE_DIR="$APPDIR/usr/lib64/gio/modules"
export GDK_PIXBUF_MODULE_FILE="$APPDIR/usr/lib64/gdk-pixbuf-2.0/2.10.0/loaders.cache"

# The bundled fontconfig can't parse newer hosts' config files and warns about
# every one, so it reads its own (build.sh keeps it inside the AppDir).
export FONTCONFIG_PATH="$APPDIR/etc/fonts"

# Pango
export PANGO_LIBDIR="$APPDIR/usr/lib"

# GLib schemas
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"

# Use in-memory GSettings backend so dconf/dbus is never needed.
# Without this, GTK spams "failed to commit changes to dconf" warnings
# on systems where dbus-launch is unavailable or not running as root.
export GSETTINGS_BACKEND=memory

# Icons and themes
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# --- Launch helpers -----------------------------------------------------------
# -I: find the stdlib next to the binary and ignore PYTHON* env vars and
# ~/.local, so nothing from the host's Python can leak in.
PYTHON=("$APPDIR/usr/bin/python3" -I -W ignore::SyntaxWarning)
py() { exec "${PYTHON[@]}" -c "$@"; }
run_cli()   { py 'import sys; sys.argv[0] = "woeusb"; from WoeUSB import core; core.run()' "$@"; }
run_about() { py 'from WoeUSB import core; core.print_application_info()'; }

check_wx() {
    local wx_import_error

    if ! wx_import_error=$("${PYTHON[@]}" -c "import wx; import wx.adv" 2>&1); then
        echo "ERROR: Failed to import wxPython. The AppImage may be corrupted." >&2
        echo "$wx_import_error" >&2
        echo "       Try re-downloading the AppImage or report this build as broken." >&2
        exit 1
    fi
}

# --- Root elevation ----------------------------------------------------------
# Allow --help/-h and --version without root
NEEDS_ROOT=1
for arg in "$@"; do
    case "$arg" in
        --help|-h|--version|-V|--about|-ab) NEEDS_ROOT=0; break ;;
    esac
done

if [ "${1:-}" = "--cli" ] && [ "$NEEDS_ROOT" -eq 0 ]; then
    shift
    case "${1:-}" in
        --about|-ab)
            run_about
            ;;
    esac
    run_cli "$@"
fi

if [ "${1:-}" != "--cli" ]; then
    case "${1:-}" in
        --about|-ab)
            run_about
            ;;
        --help|-h|--version|-V)
            run_cli "$@"
            ;;
    esac

    check_wx
fi

if [ "$EUID" -ne 0 ] && [ "$NEEDS_ROOT" -eq 1 ]; then
    echo "WoeUSB-ng requires root privileges for disk operations."

    # Prefer pkexec (shows a GUI auth dialog), fall back to sudo
    ELEVATE=$(command -v pkexec || command -v sudo) || {
        echo "ERROR: Neither pkexec nor sudo is available." >&2
        echo "       Re-run as root: sudo $0 $*" >&2
        exit 1
    }
    echo "Elevating with ${ELEVATE##*/}..."
    exec "$ELEVATE" env \
        DISPLAY="${DISPLAY:-}" \
        XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
        DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
        "${APPIMAGE:-$(readlink -f "$0")}" "$@"
fi

# --- Launch ------------------------------------------------------------------
if [ "${1:-}" = "--cli" ]; then
    shift
    run_cli "$@"
fi

# Default: launch GUI. EPEL's wxPython 4.2.0 checks for a display with
# XOpenDisplay, but compositors that start Xwayland without an auth cookie
# (Hyprland, Sway...) only let the session user in, not root. Check through
# GDK instead, like newer wxPython, so a Wayland display counts too.
py '
import ctypes, wx
gdk = ctypes.CDLL("libgdk-3.so.0")
gdk.gdk_display_open.restype = ctypes.c_void_p
def display_available():
    display = gdk.gdk_display_open(None)
    if display:
        gdk.gdk_display_close(ctypes.c_void_p(display))
    return bool(display)
wx.App.IsDisplayAvailable = staticmethod(display_available)
from WoeUSB import gui
gui.run()
' "$@"
